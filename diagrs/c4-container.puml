@startuml C4 Container Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров - Сервис кино

Person(user, "Пользователь", "Использует сервис для просмотра фильмов")
Person(admin, "Администратор", "Управляет контентом и пользователями")

System_Boundary(cinema_system, "Сервис кино") {
    Container(api_gateway, "API Gateway", "FastAPI, Python", "Единая точка входа для всех запросов")
    Container(auth_service, "AuthService", ".NET Core, C#", "Сервис аутентификации и авторизации")
    Container(user_service, "UserService", "Kotlin, Ktor", "Управление пользователями")
    Container(app_service, "AppService", "Kotlin, Ktor", "Управление фильмами и рекомендациями")
    Container(prolog_server, "Prolog Server", "SWI-Prolog", "Генерация рекомендаций на основе логики")
    
    ContainerDb(mongodb, "MongoDB", "MongoDB", "Хранит данные о фильмах, пользователях и авторизации")
    ContainerDb(redis, "Redis", "Redis", "Кэширование и очереди сообщений")
    ContainerDb(kafka, "Kafka", "Apache Kafka", "Очередь сообщений для асинхронной обработки")
    ContainerDb(zookeeper, "Zookeeper", "Apache Zookeeper", "Координация Kafka")
}

System_Ext(video_hosting, "Хостинг видео", "Внешний сервис для хранения видео")

Rel(user, api_gateway, "Использует", "HTTPS")
Rel(admin, api_gateway, "Использует", "HTTPS")

Rel(api_gateway, auth_service, "Проверяет авторизацию", "HTTP")
Rel(api_gateway, user_service, "Запросы пользователей", "HTTP")
Rel(api_gateway, app_service, "Запросы фильмов", "HTTP")

Rel(auth_service, mongodb, "Читает/Записывает", "MongoDB Protocol")
Rel(user_service, mongodb, "Читает/Записывает", "MongoDB Protocol")
Rel(app_service, mongodb, "Читает/Записывает", "MongoDB Protocol")

Rel(app_service, redis, "Кэширует данные", "Redis Protocol")
Rel(prolog_server, redis, "Читает/Записывает рекомендации", "Redis Protocol")

Rel(app_service, kafka, "Отправляет сообщения", "Kafka Protocol")
Rel(user_service, kafka, "Отправляет сообщения", "Kafka Protocol")
Rel(kafka, zookeeper, "Координация", "Zookeeper Protocol")

Rel(app_service, prolog_server, "Запрашивает рекомендации", "HTTP")
Rel(app_service, video_hosting, "Получает видео", "HTTPS")

@enduml

