@startuml c4-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов (C4 Component)

Person(user, "Пользовательский интерфейс")

System_Boundary(backend, "Backend - Микросервисная архитектура") {
    Component(api_gateway, "API Gateway", "FastAPI", "Точка входа для всех запросов, маршрутизация, аутентификация")
    Component(nginx, "Nginx", "Web Server", "Балансировщик нагрузки")
    Component(auth_service, "Сервис авторизации", ".NET", "Управление аутентификацией и авторизацией пользователей")
    Component(user_service, "Сервис пользователей", "Kotlin/Ktor", "Управление профилями пользователей")
    Component(app_service, "Сервис фильмов", "Kotlin/Ktor", "Управление фильмами и контентом")
    Component(prolog_server, "Сервис рекомендаций", "SWI-Prolog", "Логический сервер для рекомендаций")
}

ContainerDb(database, "База данных", "MongoDB", "Хранилище данных")
ContainerDb(redis, "Кэш", "Redis")
Container(kafka, "Брокер сообщений", "Kafka + Zookeeper", "Обработка событий")

System_Ext(video_hosting, "Хостинг видео", "Внешний сервис видео")

' Взаимодействие пользователя
Rel(user, nginx, "HTTP/HTTPS запросы")
Rel(nginx, api_gateway, "Перенаправляет запросы")

' Взаимодействие между микросервисами
Rel(api_gateway, auth_service, "Проверка токенов, аутентификация", "REST API")
Rel(api_gateway, user_service, "Операции с пользователями", "REST API")
Rel(api_gateway, app_service, "Операции с фильмами", "REST API")

Rel(user_service, auth_service, "Проверка прав доступа", "REST API")
Rel(app_service, user_service, "Получение данных пользователя", "REST API")
Rel(app_service, prolog_server, "Получение рекомендаций", "REST API")

' Взаимодействие с инфраструктурой
Rel(auth_service, database, "Чтение/запись данных пользователей")
Rel(user_service, database, "Чтение/запись профилей")
Rel(app_service, database, "Чтение/запись данных фильмов")

Rel(auth_service, redis, "Хранение токенов и сессий")
Rel(user_service, redis, "Кэширование")
Rel(prolog_server, redis, "Запись рекомендаций")

Rel(app_service, redis, "Кэширование")
Rel(user_service, kafka, "События")
Rel(app_service, kafka, "События контента")

Rel(app_service, video_hosting, "Получение видео", "HTTPS/API")

@enduml

