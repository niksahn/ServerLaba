@startuml C4 Context Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контекста - Сервис кино

Person(user, "Пользователь", "Использует сервис для просмотра фильмов и получения рекомендаций")
Person(admin, "Администратор", "Управляет контентом и пользователями системы")

System(cinema_service, "Сервис кино", "Микросервисная платформа для управления фильмами, пользователями и рекомендациями")

System_Ext(video_hosting, "Хостинг видео", "Внешний сервис для хранения и доставки видео контента")

Rel(user, cinema_service, "Просматривает фильмы, получает рекомендации", "HTTPS")
Rel(admin, cinema_service, "Управляет контентом и пользователями", "HTTPS")
Rel(cinema_service, video_hosting, "Получает видео контент", "HTTPS")

@enduml

