@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма системы - Микросервисная платформа управления пользователями и контентом

Person(user, "Пользователь", "Обычный пользователь системы, просматривает фильмы и получает рекомендации")
Person(admin, "Администратор", "Управляет пользователями и контентом, имеет полный доступ к системе")
Person(moderator, "Модератор", "Управляет контентом (фильмами), модерирует пользовательский контент")

System(system, "Микросервисная платформа", "Система управления пользователями и контентом, предоставляет API для аутентификации, управления пользователями, работы с фильмами и получения рекомендаций на основе Prolog логики")

Rel(user, system, "Использует", "HTTPS/REST API")
Rel(admin, system, "Управляет", "HTTPS/REST API")
Rel(moderator, system, "Модерирует", "HTTPS/REST API")

@enduml

